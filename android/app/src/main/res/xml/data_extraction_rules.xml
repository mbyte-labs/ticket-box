<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup and device-to-device transfer rules for Android 12 and higher (see backup_rules.xml
  for why the artwork and the browse cache database stay out).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="assets/" />
        <exclude domain="file" path="tbBrowseImages.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="assets/" />
        <exclude domain="file" path="tbBrowseImages.db" />
    </device-transfer>
</data-extraction-rules>
